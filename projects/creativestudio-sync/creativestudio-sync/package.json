{
  'name': 'creativestudio-comment-system',
  'version': '1.0.0',
  'description': 'Real-time comment system with live updates, notifications, and threaded discussions',
  'main': 'dist/index.js',
  'scripts': {
    'build': 'tsc && node dist/index.js',
    'start': 'node dist/index.js',
    'dev': 'ts-node src/index.ts',
    'test': 'jest --coverage',
    'lint': 'eslint src/',
    'type-check': 'tsc --noEmit'
  },
  'dependencies': {
    'express': '^4.18.2',
    'ws': '^8.14.2',
    'typescript': '^5.3.0'
  },
  'devDependencies': {
    '@types/express': '^4.17.21',
    '@types/node': '^20.10.0',
    '@types/ws': '^8.5.10',
    'ts-node': '^10.9.2',
    'typescript': '^5.3.0'
  }
}