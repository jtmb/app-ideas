# PawPrint Tracker — Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================

# Application name (optional, defaults to "PawPrint Tracker")
APP_NAME=PawPrint Tracker

# Application version (optional, defaults to "1.0.0")
APP_VERSION=1.0.0

# Node.js environment: development, staging, or production
NODE_ENV=development

# Port the application listens on (optional, defaults to 3000)
PORT=3000

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pawprint_tracker

# Alternative: Individual database settings
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pawprint_tracker
# DB_USER=postgres
# DB_PASSWORD=password

# ===========================================
# API Configuration
# ===========================================

# API version for URL paths (optional, defaults to "v1")
API_VERSION=v1

# Rate limiting window in milliseconds (optional, defaults to 60000)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (optional, defaults to 100)
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CORS Configuration
# ===========================================

# Allowed origins (comma-separated, use * for all in development)
CORS_ALLOWED_ORIGINS=*

# Allow credentials for cross-origin requests (true/false)
CORS_ALLOW_CREDENTIALS=false

# Max age for preflight cache in seconds (optional, defaults to 86400)
CORS_MAX_AGE=86400

# ===========================================
# Logging Configuration
# ===========================================

# Log level: error, warn, info, debug, verbose
LOG_LEVEL=info

# Output format: json or text
LOG_FORMAT=text

# ===========================================
# Feature Flags
# ===========================================

# Enable authentication middleware (true/false)
AUTH_ENABLED=false

# Enable rate limiting (true/false)
RATE_LIMITING_ENABLED=true

# Enable request logging (true/false)
REQUEST_LOGGING_ENABLED=true